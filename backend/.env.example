APP_NAME="Zentry POS"
APP_ENV=local
APP_TIMEZONE=America/Bogota
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
# En Docker: DB_HOST=postgres (nombre del servicio en docker-compose.yml)
# En local:  DB_HOST=127.0.0.1 (PostgreSQL corriendo en tu máquina o vía Docker port-forward)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zentry_pos
DB_USERNAME=zentry_user
DB_PASSWORD=secret123

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@zentrypos.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend / Sanctum ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8443
SANCTUM_STATEFUL_DOMAINS=localhost:8443,127.0.0.1:8443
